# Staging Environment
# Copy this to .env.staging and fill in your staging credentials
#
# Run with staging environment:
#   bun dev:staging         - Run dev server with staging env
#   bun build:staging       - Build with staging env
#
# Set as default environment:
#   bun env:staging         - Copy to .env (makes it default)

# ============================================
# SUPABASE (Staging Branch)
# ============================================
# Get from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=staging-publishable-key-here
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=staging-publishable-key-here
SUPABASE_SECRET_KEY=staging-secret-key-here
DATABASE_URL=postgresql://postgres.[PASSWORD]@db.xxxxx.supabase.co:5432/postgres?pgbouncer=true

# ============================================
# APP CONFIGURATION
# ============================================
VITE_APP_ENV=staging
EXPO_PUBLIC_APP_ENV=staging
NODE_ENV=production

# App deep link scheme (mobile only - used for OAuth redirects)
EXPO_PUBLIC_APP_SCHEME=test-cicd

# ============================================
# ANALYTICS (PostHog Staging)
# ============================================
VITE_POSTHOG_KEY=phc_staging_key
EXPO_PUBLIC_POSTHOG_KEY=phc_staging_key
VITE_POSTHOG_HOST=https://app.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# ERROR TRACKING (Sentry Staging)
# ============================================
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
VITE_SENTRY_ORG=your-org
EXPO_PUBLIC_SENTRY_ORG=your-org
VITE_SENTRY_PROJECT=your-project-staging
EXPO_PUBLIC_SENTRY_PROJECT=your-project-staging
SENTRY_AUTH_TOKEN=staging-auth-token

# ============================================
# MONETIZATION (RevenueCat Staging)
# ============================================
VITE_REVENUECAT_API_KEY=staging_public_key
EXPO_PUBLIC_REVENUECAT_API_KEY=staging_public_key
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_staging_xxx
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_staging_xxx
REVENUECAT_WEBHOOK_SECRET=staging_webhook_secret
