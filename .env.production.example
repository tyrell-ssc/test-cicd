# Production Environment
# Copy this to .env.production and fill in your production credentials
#
# ⚠️  WARNING: Be extra careful with production credentials!
#
# Run with production environment:
#   bun dev:production      - Run dev server with production env
#   bun build:production    - Build with production env
#
# Set as default environment:
#   bun env:production      - Copy to .env (makes it default)

# ============================================
# SUPABASE (Production)
# ============================================
# Get from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=prod-publishable-key-here
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=prod-publishable-key-here
SUPABASE_SECRET_KEY=prod-secret-key-here
DATABASE_URL=postgresql://postgres.[PASSWORD]@db.xxxxx.supabase.co:5432/postgres?pgbouncer=true

# ============================================
# APP CONFIGURATION
# ============================================
VITE_APP_ENV=production
EXPO_PUBLIC_APP_ENV=production
NODE_ENV=production

# App deep link scheme (mobile only - used for OAuth redirects)
EXPO_PUBLIC_APP_SCHEME=test-cicd

# ============================================
# ANALYTICS (PostHog Production)
# ============================================
VITE_POSTHOG_KEY=phc_production_key
EXPO_PUBLIC_POSTHOG_KEY=phc_production_key
VITE_POSTHOG_HOST=https://app.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# ERROR TRACKING (Sentry Production)
# ============================================
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
VITE_SENTRY_ORG=your-org
EXPO_PUBLIC_SENTRY_ORG=your-org
VITE_SENTRY_PROJECT=your-project-production
EXPO_PUBLIC_SENTRY_PROJECT=your-project-production
SENTRY_AUTH_TOKEN=production-auth-token

# ============================================
# MONETIZATION (RevenueCat Production)
# ============================================
VITE_REVENUECAT_API_KEY=production_public_key
EXPO_PUBLIC_REVENUECAT_API_KEY=production_public_key
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_production_xxx
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_production_xxx
REVENUECAT_WEBHOOK_SECRET=production_webhook_secret
