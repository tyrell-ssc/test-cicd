{
  "name": "@test-cicd/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prebuild": "bun --env-file=../../.env.development expo prebuild",
    "prebuild:staging": "bun --env-file=../../.env.staging expo prebuild",
    "prebuild:production": "bun --env-file=../../.env.production expo prebuild",
    "dev": "bun --env-file=../../.env.development expo start",
    "dev:staging": "bun --env-file=../../.env.staging expo start",
    "dev:production": "bun --env-file=../../.env.production expo start",
    "android": "bun --env-file=../../.env.development expo run:android",
    "android:staging": "bun --env-file=../../.env.staging expo run:android",
    "android:production": "bun --env-file=../../.env.production expo run:android",
    "ios": "bun --env-file=../../.env.development expo run:ios",
    "ios:staging": "bun --env-file=../../.env.staging expo run:ios",
    "ios:production": "bun --env-file=../../.env.production expo run:ios",
    "web": "bun --env-file=../../.env.development expo start --web",
    "web:staging": "bun --env-file=../../.env.staging expo start --web",
    "web:production": "bun --env-file=../../.env.production expo start --web"
  },
  "dependencies": {
    "expo": "~54.0.30",
    "expo-router": "~6.0.21",
    "expo-font": "~14.0.10",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "^15.0.10",
    "expo-constants": "~18.0.12",
    "expo-linking": "~8.0.11",
    "expo-auth-session": "^7.0.10",
    "expo-crypto": "^15.0.8",
    "@expo/vector-icons": "^15.0.3",
    "@expo-google-fonts/space-mono": "^0.2.3",
    "react-native-mmkv": "^4.1.0",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.62.8",
    "@test-cicd/ui": "workspace:*",
    "@test-cicd/app": "workspace:*",
    "@test-cicd/supabase": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1",
    "nativewind": "^4.2.1",
    "semver": "^7.6.3",
    "posthog-react-native": "^3.1.0",
    "react-native-get-random-values": "^1.11.0",
    "@sentry/react-native": "~7.2.0",
    "react-native-purchases": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "tailwindcss": "^3.4.17"
  }
}
