# Local Development Environment
# Run 'bun setup' to automatically configure Supabase values
#
# 🔄 ENVIRONMENT SWITCHING
# This wizard uses separate env files for each environment:
#   .env.development - Local development (auto-configured by 'bun setup')
#   .env.staging     - Staging environment (create with your staging credentials)
#   .env.production  - Production environment (create with your production credentials)
#
# Run with specific environments:
#   bun dev              - Run with .env.development (default)
#   bun dev:staging      - Run with .env.staging
#   bun dev:production   - Run with .env.production

# ============================================
# SUPABASE (Local)
# ============================================
# Web app (VITE_ prefix for client-side)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Mobile app (EXPO_PUBLIC_ prefix for client-side)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server-side only (no prefix)
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ============================================
# APP CONFIGURATION
# ============================================
VITE_APP_ENV=development
EXPO_PUBLIC_APP_ENV=development
NODE_ENV=development

# App URLs
VITE_SITE_URL=http://127.0.0.1:3000
VITE_ADMIN_URL=http://127.0.0.1:3001
EXPO_PUBLIC_SITE_URL=test-cicd://api
EXPO_PUBLIC_ADMIN_URL=test-cicd://admin

# App deep link scheme (mobile only - used for OAuth redirects)
EXPO_PUBLIC_APP_SCHEME=test-cicd

# ============================================
# ANALYTICS (PostHog) - Optional
# ============================================
# Get from: https://app.posthog.com/project/settings
# Public keys are safe to expose (used for client-side tracking)
VITE_POSTHOG_KEY=phc_your_key_here
EXPO_PUBLIC_POSTHOG_KEY=phc_your_key_here
VITE_POSTHOG_HOST=https://app.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# ERROR TRACKING (Sentry) - Optional
# ============================================
# Get from: https://sentry.io/settings/projects/your-project/keys/
# DSN is safe to expose (used for client-side error reporting)
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# Organization and project (safe to expose, used for Sentry SDK)
VITE_SENTRY_ORG=your-org
EXPO_PUBLIC_SENTRY_ORG=your-org
VITE_SENTRY_PROJECT=your-project
EXPO_PUBLIC_SENTRY_PROJECT=your-project
# Server-side only (for build scripts and CI/CD)
SENTRY_AUTH_TOKEN=your-auth-token

# ============================================
# MONETIZATION (RevenueCat) - Optional
# ============================================
# Get from: https://app.revenuecat.com/projects
# Public API keys are safe to expose (used for purchases)
VITE_REVENUECAT_API_KEY=your_public_api_key
EXPO_PUBLIC_REVENUECAT_API_KEY=your_public_api_key
# Platform-specific keys (mobile only)
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_xxx
# Server-side only (for webhook validation)
REVENUECAT_WEBHOOK_SECRET=your_webhook_secret
